{
  "name": "@josephmark/createstyle",
  "version": "1.2.0",
  "description": "A simple utility for creating React components with pre-determined classes",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/esm/index.d.ts",
  "exports": {
    ".": {
      "require": "./lib/cjs/index.cjs",
      "import": "./lib/esm/index.mjs",
      "types": "./lib/esm/index.d.ts"
    }
  },
  "scripts": {
    "test": "eslint --no-ignore ./src/* && tsc --noEmit",
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsdown",
    "build:cjs": "tsdown --format cjs --outDir lib/cjs --declaration --emitDeclarationOnly",
    "prepublishOnly": "npm run -s build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whoisjosephmark/createStyle.git"
  },
  "keywords": [
    "react",
    "tailwind",
    "typescript",
    "styled-components",
    "classnames",
    "css-in-js",
    "utility",
    "forwardRef",
    "components"
  ],
  "files": [
    "lib/**/*.mjs",
    "lib/**/*.cjs",
    "lib/**/*.d.mts",
    "lib/**/*.d.cts",
    "lib/**/*.map"
  ],
  "author": "@floatingdino",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/whoisjosephmark/createStyle/issues"
  },
  "homepage": "https://github.com/whoisjosephmark/createStyle#readme",
  "devDependencies": {
    "@josephmark/eslint-config-react": "^1.1.0",
    "eslint": "^9.4.0",
    "prettier": "^3.8.3",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@types/react": "^18.3.3 || ^19.0.0",
    "react": "^18.3.1 || ^19.0.0"
  }
}
